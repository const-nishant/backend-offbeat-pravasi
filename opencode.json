{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["code-review-graph", "mcp"],
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": ["npx", "ast-grep-mcp"],
      "enabled": true
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
